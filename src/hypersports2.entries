0x5495   # entrada 0
0x54E1   # entrada 1
0x54E8   # entrada 2
0x54ED   # entrada 3
0x5486   # entrada 4

# --- Direcciones de RETORNO metidas en la pila: el despachador no vuelve al
# call, asi que lo que tiene que correr detras se empuja antes. Ojo: entre el
# `ld hl,NN` y el `push hl` puede haber otras instrucciones, asi que no basta
# con buscar la pareja pegada.
0x4CC8   # `ld hl,04cc8h` en 0x4DF4 y `push hl` en 0x4DF7
0x521C   # `ld hl,0521ch` en 0x5147 y `push hl` en 0x514A
0x44E6   # `ld hl,044e6h` en 0x40BE y `push hl` en 0x40C3, con un `ld a,(nn)` en
         # medio. Es lo que corre detras de cada uno de los 11 estados del
         # despacho de 0x40C5.
0x4F87   # `ld hl,04f87h` en 0x4EBA y `push hl` en 0x4EC0, igual: lo que corre
         # detras del despacho de 0x4EC1.
